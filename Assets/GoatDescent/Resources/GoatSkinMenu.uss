.skin-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.overlay { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(8,14,20,.88); align-items: center; justify-content: center; }
.skin-panel { width: 94%; max-width: 1040px; background-color: rgb(24,34,42); border-radius: 20px; padding: 20px; }
.heading { font-size: 28px; color: rgb(255,245,221); -unity-font-style: bold; }
.subtitle { font-size: 15px; color: rgb(169,187,192); margin-top: 4px; margin-bottom: 10px; }
.players { flex-direction: row; margin-bottom: 8px; }
.players Button { padding: 8px 22px; margin-right: 8px; background-color: rgb(45,61,71); border-width: 0; border-radius: 8px; color: white; font-size: 16px; }
.players Button.active { background-color: rgb(216,170,92); color: rgb(24,34,42); }
.cards { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.skin-card { width: 19%; height: 250px; padding: 0; margin-bottom: 10px; background-color: rgb(48,64,74); border-width: 3px; border-color: rgb(48,64,74); border-radius: 12px; overflow: hidden; }
.skin-card:hover { border-color: rgb(132,160,163); }
.skin-card.selected { border-color: rgb(248,193,99); }
.skin-picture { flex-grow: 1; width: 100%; -unity-background-scale-mode: scale-to-fit; }
.skin-name { height: 34px; font-size: 14px; color: rgb(246,241,223); -unity-text-align: middle-center; -unity-font-style: bold; }
.footer { flex-direction: row; align-items: center; justify-content: space-between; margin-top: 4px; }
.selection { font-size: 15px; color: rgb(233,197,135); }
.close-button { background-color: rgb(220,173,93); color: rgb(24,34,42); padding: 10px 16px; border-width: 0; border-radius: 8px; font-size: 15px; }
.open-button { position: absolute; right: 20px; bottom: 20px; padding: 10px 18px; font-size: 16px; color: white; background-color: rgb(30,46,56); border-width: 1px; border-color: rgb(111,140,148); border-radius: 8px; }
