    smallestOccluder: 5
    smallestHole: 0.25
    backfaceThreshold: 100
--- !u!104 &2
RenderSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 9
  m_Fog: 1
  m_FogColor: {r: 0.62, g: 0.72, b: 0.78, a: 1}
  m_FogMode: 1
  m_FogDensity: 0.008
  m_FogStartDistance: 55
  m_FogEndDistance: 180
  m_AmbientSkyColor: {r: 0.45, g: 0.55, b: 0.65, a: 1}
  m_AmbientEquatorColor: {r: 0.36, g: 0.38, b: 0.35, a: 1}
  m_AmbientGroundColor: {r: 0.18, g: 0.17, b: 0.16, a: 1}
  m_AmbientIntensity: 1
  m_DefaultReflectionMode: 0
  m_DefaultReflectionResolution: 128
  m_ReflectionBounces: 1
  m_ReflectionIntensity: 0.45
  m_Skybox: {fileID: 0}
  m_HaloStrength: 0.5
  m_FlareStrength: 1
  m_FlareFadeSpeed: 3
  m_HaloTexture: {fileID: 0}
  m_SpotCookie: {fileID: 0}
  m_DefaultReflection: {fileID: 0}
  m_CustomReflection: {fileID: 0}
  m_Sun: {fileID: 0}
--- !u!157 &3
LightmapSettings:
  m_ObjectHideFlags: 0
  serializedVersion: 12
  m_GIWorkflowMode: 1
